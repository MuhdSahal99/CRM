{
  "name": "saqient-crm",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter web e2e",
