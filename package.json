{
  "name": "saqient-crm",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "check": "pnpm -r check",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "e2e": "pnpm --filter web e2e",
    "infra:up": "docker compose --env-file .env.local up -d --wait",
    "infra:down": "docker compose --env-file .env.local down",
    "db:migrate": "pnpm --filter @crm/db migrate",
    "db:seed": "pnpm --filter @crm/db seed"
  }
}
