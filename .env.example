# Copy to .env.local and replace every <placeholder>. .env.local is gitignored.
NODE_ENV=development

# Superuser for the local Postgres container only; the app never uses it.
POSTGRES_PASSWORD=<local-superuser-password>

# App connection as crm_app (no BYPASSRLS, no DDL; ADR-0003).
DATABASE_URL=postgres://crm_app:<crm-app-password>@localhost:5433/crm

REDIS_URL=redis://localhost:6379

# DB roles created by packages/db/bootstrap/01-roles.sh (ADR-0003).
CRM_OWNER_PASSWORD=<crm-owner-password>
CRM_APP_PASSWORD=<crm-app-password>
CRM_AUTH_PASSWORD=<crm-auth-password>

# Migrations only (crm_owner). The app never uses this URL.
DATABASE_OWNER_URL=postgres://crm_owner:<crm-owner-password>@localhost:5433/crm

# Integration tests: same roles, separate database.
TEST_DATABASE_URL=postgres://crm_app:<crm-app-password>@localhost:5433/crm_test
TEST_DATABASE_OWNER_URL=postgres://crm_owner:<crm-owner-password>@localhost:5433/crm_test
SEED_PASSWORD=<dev-password>